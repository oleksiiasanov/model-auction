# Auction Simulator Local Configuration
#
# This is a template for your local configuration.
# Copy this file to config/local.yaml and fill in your credentials.
#
# IMPORTANT: local.yaml is gitignored. Never commit credentials!
#
# Usage:
#   cp config/local.yaml.template config/local.yaml
#   # Edit config/local.yaml with your credentials
#   python -m auction_simulator.cli simulate --config config/local.yaml [options]

# Simulation parameters
simulation:
  epsilon: 0.001
  pacing_tolerance: 0.2
  bid_step: 0.1
  batch_size: 40
  min_bid_fallback: 100

# Database configuration (ClickHouse)
# REPLACE THESE WITH YOUR ACTUAL CREDENTIALS
database:
  host: "your-clickhouse-host.example.com"  # REQUIRED: Your ClickHouse server hostname
  port: 9000                                 # Default ClickHouse port
  database: "analytics"                      # REQUIRED: Your database name
  user: "your-username"                      # REQUIRED: Your ClickHouse username
  password: "your-password"                  # REQUIRED: Your ClickHouse password
  connect_timeout: 30
  send_receive_timeout: 300

# Data caching
cache:
  directory: "data/cache"
  ttl_hours: 24

# Reporting
reporting:
  output_directory: "outputs"
  decimal_places: 2
  currency_unit: "AZN"  # Change based on country (AZN, UAH, etc.)

# Logging
logging:
  level: "INFO"
  format: "json"
  file: "simulation.log"
